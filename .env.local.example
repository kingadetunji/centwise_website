# Email delivery via Resend (https://resend.com — free tier: 3,000 emails/month)
# 1. Create a free account at resend.com
# 2. Add and verify your sending domain (or use the sandbox for testing)
# 3. Generate an API key and paste it below
# 4. Copy this file to .env.local
RESEND_API_KEY=re_your_api_key_here

# The "from" address used when sending contact form emails.
# Must be on a domain you have verified in Resend.
RESEND_FROM_EMAIL=office@centwiseai.ca

# Where form submissions are delivered.
CONTACT_TO_EMAIL=office@centwiseai.ca
